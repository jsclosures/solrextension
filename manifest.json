{"manifest_version": 3,
  "name": "SOLR Request Monitor",
  "version": "1.0.0",
  "description": "Monitor and display all HTTP/HTTPS requests made by the current page",
  "permissions": [
    "webRequest",
    "webNavigation",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}